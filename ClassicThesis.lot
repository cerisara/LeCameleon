\contentsline {table}{\numberline {3.1}{\ignorespaces Positioning of our approach within the compression literature. \textbf {No Custom Kernel} indicates that a custom GPU kernel is not required to observe speedup and \textbf {No Ampere-only} is whether the method requires Ampere GPU to achieve speedup. \textbf {Calib. Data} is the total number of tokens in billions used for compression.}}{34}{table.caption.18}%
\contentsline {table}{\numberline {3.2}{\ignorespaces Benchmarks and corresponding metrics that were used to evaluate the models.}}{45}{table.caption.24}%
\contentsline {table}{\numberline {3.3}{\ignorespaces \textbf {Zero-shot evaluation results} for the base non-compressed models (0\%), and the 20\%, 25\%, and 30\% compressed models.}}{46}{table.caption.29}%
\contentsline {table}{\numberline {3.4}{\ignorespaces \textbf {Compressed models save memory and speedup computation.} Inference speed was measured on a single A100 GPU, using the whole test split of Wikitext2 using a batch size of 4 and by varying the sequence length from 512 to 16384 tokens. All the models were loaded in bf16 and used Flash-Attention2. OOM stands for Out-Of-Memory.}}{46}{table.caption.30}%
\contentsline {table}{\numberline {3.5}{\ignorespaces \textbf {40\% compressed Phi-2 3B competes with models of similar size while being compressed using only 13M tokens.} Compressing Phi-2 3B to 1.7B (by removing 40\% of the parameters) and comparing its zero-shot performance to other recent language models of similar sizes.}}{47}{table.caption.31}%
\contentsline {table}{\numberline {3.6}{\ignorespaces \textbf {Compressed models recover well when finetuned.} Zero-shot performances of the base non-compressed models (0\%) and the 40\% compressed models, without and with fine-tuning (FT). Models were fine-tuned on the whole Slim-Orca dataset (191 million tokens).}}{47}{table.caption.32}%
\contentsline {table}{\numberline {3.7}{\ignorespaces \textbf {Mamba-based Language Models can be efficiently compressed}. Zero-shot evaluation results for the non-compressed (0\%) and for the compressed Mamba-based Language Models (20\%)}}{48}{table.caption.35}%
\contentsline {table}{\numberline {3.8}{\ignorespaces \textbf {Compressing mamba models saves memory and speeds up computation.} Inference speed was measured on a single A100 GPU, using the whole test split of Wikitext2 with a batch size of 4 and by varying the sequence length from 512 to 16384 tokens. All models were loaded in bf16 and used Flash-Attention2.}}{48}{table.caption.36}%
\contentsline {table}{\numberline {3.9}{\ignorespaces \textbf {The 37\% compressed Whisper is faster, 1.46$\times $ lighter.} The WER is computed on the English test subset of the Fleurs dataset. The speed (tokens/second) corresponds to the transcription of 400 tokens from a dataset containing 2,048 speech examples, using a batch size of 128. A single A100 GPU is used and the model is loaded in FP32, without Flash-Attention. We also give the GPU Memory (VRAM) occupied by each model.}}{49}{table.caption.40}%
\contentsline {table}{\numberline {3.10}{\ignorespaces \textbf {The joint loss generally performs better}: Zero-shot performances of the three losses using the same setup for each model, as described in Section~\ref {sec:xp}.}}{49}{table.caption.44}%
\contentsline {table}{\numberline {3.11}{\ignorespaces Comparing the Wikitext perplexity convergence of the three losses for 2M training tokens.}}{52}{table.caption.45}%
\contentsline {table}{\numberline {3.12}{\ignorespaces Compression times for the three compression strategies at 20\% parameter reduction on a single A100 GPU. For the bottom and top-first compression strategies, we used the same hyperparameters as in Section~\ref {sec:xp}.}}{52}{table.caption.47}%
\contentsline {table}{\numberline {3.13}{\ignorespaces Average zero-shot performance for the three compression strategies at 20\% compression. For the bottom and top-first compression strategies, we used the same hyperparameters as in Section~\ref {sec:xp}.}}{53}{table.caption.49}%
\contentsline {table}{\numberline {3.14}{\ignorespaces \textbf {Comparison of our method with SliceGPT on zero-shot task evaluation for Phi-2 3B.} We give the evaluation scores before compression (0\%), both as reported by SliceGPT and as reproduced by us. Both methods use the Alpaca calibration dataset for compression.}}{53}{table.caption.50}%
\contentsline {table}{\numberline {3.15}{\ignorespaces Steve Jobs Story by the 20\% and 40\% compressed Phi-2 3B models, without \textit {any} finetuning. \textbf {Prompt: "Here the story of Steve Jobs:"}}}{54}{table.caption.51}%
\contentsline {table}{\numberline {3.16}{\ignorespaces The Civil War Story by the 20\% and 40\% compressed models, without \textit {any} finetuning. \textbf {Prompt: "What is the cause of the Civil War? Here is the story."}}}{55}{table.caption.52}%
\contentsline {table}{\numberline {3.17}{\ignorespaces Zero-shot performance on afrimmlu for the 30\% compressed InkubaLM model for the Hausa language.}}{56}{table.caption.53}%
