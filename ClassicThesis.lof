\contentsline {figure}{\numberline {2.1}{\ignorespaces Fixed-token scaling view of Chinchilla and Llama 3.1 models. Adapted from \url {https://deepmind.google/blog/an-empirical-analysis-of-compute-optimal-large-language-model-training/}}}{19}{figure.caption.10}%
\contentsline {figure}{\numberline {2.2}{\ignorespaces Illustration of unstructured pruning. The architecture is unchanged, but individual weights are removed independently.}}{19}{figure.caption.11}%
\contentsline {figure}{\numberline {2.3}{\ignorespaces Convergence of Sheared LLaMA after structured pruning and continued pre-training, compared to other models of similar sizes. Plot taken from the original paper ~\citep {xia2024sheared}}}{21}{figure.caption.12}%
\contentsline {figure}{\numberline {2.4}{\ignorespaces Illustration of structured pruning. A full layer is removed, together with all its incoming and outgoing weights.}}{22}{figure.caption.13}%
\contentsline {figure}{\numberline {2.5}{\ignorespaces Sequence-level distillation. The teacher first generates a complete answer, and the student is then trained on this synthetic sequence.}}{23}{figure.caption.14}%
\contentsline {figure}{\numberline {2.6}{\ignorespaces Off-policy distillation. The student and the teacher are evaluated on the same data, and the student distribution is trained to match the teacher distribution.}}{24}{figure.caption.15}%
\contentsline {figure}{\numberline {2.7}{\ignorespaces On-policy distillation. The student first samples an output, then the teacher evaluates this student-generated output.}}{26}{figure.caption.16}%
\contentsline {figure}{\numberline {2.8}{\ignorespaces Switch Transformer encoder block, where the dense feed-forward layer is replaced by a sparse Switch FFN layer. Figure adapted from \citet {switch}.}}{28}{figure.caption.17}%
\contentsline {figure}{\numberline {2.9}{\ignorespaces Scaling properties of Switch Transformer. Increasing the number of experts improves performance and sample efficiency at equal computational budget. Figure from \citet {switch}.}}{29}{figure.caption.18}%
\contentsline {subfigure}{\numberline {(a)}{\ignorespaces {Validation loss as the number of parameters increases.}}}{29}{subfigure.9.1}%
\contentsline {subfigure}{\numberline {(b)}{\ignorespaces {Negative log-perplexity during training.}}}{29}{subfigure.9.2}%
\contentsline {figure}{\numberline {2.10}{\ignorespaces Effect of MoE granularity on loss for fixed model size and number of training tokens. Figure adapted from \citet {krajewski2024scaling}.}}{30}{figure.caption.19}%
\contentsline {figure}{\numberline {2.11}{\ignorespaces Expert selection proportions in Mixtral across domains and layers. The dashed line corresponds to uniform routing over the eight experts. Figure adapted from \citet {jiang_mixtral_2024}.}}{32}{figure.caption.22}%
\contentsline {figure}{\numberline {2.12}{\ignorespaces Cosine similarity between languages based on expert-choice patterns in NLLB-200. Figure adapted from \citet {nllbteam2022nolanguageleftbehind}.}}{33}{figure.caption.23}%
\contentsline {figure}{\numberline {2.13}{\ignorespaces LongCat-Flash architecture with zero-computation experts. The router still selects $K$ experts, but some selected experts are identity paths, which makes the effective compute adaptive. Figure from \citet {meituanlongcatteam2025longcatflashtechnicalreport}.}}{35}{figure.caption.25}%
\contentsline {figure}{\numberline {2.14}{\ignorespaces Overview of a key-value memory layer. The input is projected into a query, compared to the memory keys, and only the values associated with the selected keys are used for computation. Figure from \citet {lample2019largememorylayersproduct}.}}{36}{figure.caption.26}%
\contentsline {figure}{\numberline {2.15}{\ignorespaces Architecture of an \textit {n}-gram embedding layer. The token embedding is augmented with hashed \textit {n}-gram embedding branches. Figure from \citet {liu2026scalingembeddingsoutperformsscaling}.}}{39}{figure.caption.31}%
\contentsline {figure}{\numberline {2.16}{\ignorespaces Matryoshka Representation Learning trains a representation to be useful at several embedding dimensions. Figure adapted from \citet {MRL}.}}{41}{figure.caption.33}%
\contentsline {figure}{\numberline {2.17}{\ignorespaces MatFormer nests several FFN sizes inside the Transformer block and trains the corresponding submodels jointly. Figure from \citet {devvrit2024matformer}.}}{42}{figure.caption.34}%
