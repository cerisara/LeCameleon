\contentsline {figure}{\numberline {2.5}{\ignorespaces Sequence-level distillation. The teacher first generates a complete answer, and the student is then trained on this synthetic sequence.}}{25}{figure.caption.16}%
\contentsline {figure}{\numberline {2.6}{\ignorespaces Off-policy distillation. The student and the teacher are evaluated on the same data, and the student distribution is trained to match the teacher distribution.}}{26}{figure.caption.17}%
