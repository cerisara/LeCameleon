\contentsline {figure}{\numberline {2.1}{\ignorespaces Fixed-token scaling view of Chinchilla and Llama 3.1 models.}}{21}{figure.caption.11}%
\contentsline {figure}{\numberline {2.2}{\ignorespaces Illustration of unstructured pruning. The architecture is unchanged, but individual weights are removed independently.}}{21}{figure.caption.12}%
\contentsline {figure}{\numberline {2.3}{\ignorespaces Illustration of structured pruning. A full layer is removed, together with all its incoming and outgoing weights.}}{24}{figure.caption.13}%
\contentsline {figure}{\numberline {2.4}{\ignorespaces Sequence-level distillation. The teacher first generates a complete answer, and the student is then trained on this synthetic sequence.}}{24}{figure.caption.14}%
\contentsline {figure}{\numberline {2.5}{\ignorespaces Off-policy distillation. The student and the teacher are evaluated on the same data, and the student distribution is trained to match the teacher distribution.}}{25}{figure.caption.15}%
\contentsline {figure}{\numberline {2.6}{\ignorespaces On-policy distillation. The student first samples an output, then the teacher evaluates this student-generated output.}}{27}{figure.caption.16}%
