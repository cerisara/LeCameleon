\contentsline {figure}{\numberline {2.1}{\ignorespaces Fixed-token scaling view of Chinchilla and Llama 3.1 models. Adapted from \url {https://deepmind.google/blog/an-empirical-analysis-of-compute-optimal-large-language-model-training/}}}{19}{figure.caption.10}%
\contentsline {figure}{\numberline {2.2}{\ignorespaces Illustration of unstructured pruning. The architecture is unchanged, but individual weights are removed independently.}}{19}{figure.caption.11}%
