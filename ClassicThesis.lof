\contentsline {figure}{\numberline {3.1}{\ignorespaces \textbf {Lillama approach}: \textbf {STEP 1} selects layers to compress for a target compression ratio (e.g., N\%) using various strategies (see Section \ref {sec:algo}). \textbf {STEP 2} compresses and initializes the chosen parameters via SVD. \textbf {STEP 3} distills the low-rank weights with a small calibration dataset.}}{47}{figure.caption.37}%
\contentsline {figure}{\numberline {3.2}{\ignorespaces \textbf {Activations are low-rank.} Comparison of the stable rank of weights (\texttt {*\_proj}) and layer activations (\texttt {layer\_activations}). Each bar is the average stable rank across all layers.}}{50}{figure.caption.39}%
\contentsline {figure}{\numberline {3.3}{\ignorespaces Accelerating convergence through a joint loss}}{53}{figure.caption.40}%
\contentsline {subfigure}{\numberline {(a)}{\ignorespaces {Teacher}}}{53}{subfigure.3.1}%
\contentsline {subfigure}{\numberline {(b)}{\ignorespaces {Student}}}{53}{subfigure.3.2}%
\contentsline {subfigure}{\numberline {(c)}{\ignorespaces {Teacher+Student}}}{53}{subfigure.3.3}%
\contentsline {figure}{\numberline {3.4}{\ignorespaces Illustration of 20\% compression when using the three strategies: bottom, top, and uniform. Green boxes are compressed layers with low-rank matrices while gray boxes are non-compressed ones. $l_{1}$, $l_{2}$, ..., $l_{n-1}$, $l_{n}$ are the layer indexes.}}{55}{figure.caption.41}%
\contentsline {figure}{\numberline {3.5}{\ignorespaces Example of PyTorch implementation of our approach using the Teacher-only distillation strategy.}}{57}{figure.caption.43}%
\contentsline {figure}{\numberline {3.6}{\ignorespaces \textbf {Higher ranks give generally better results.} Mean accuracy over our test benchmarks as a function of the minimum rank $k$ in Algorithm~\ref {alg:two}}}{63}{figure.caption.61}%
\contentsline {figure}{\numberline {3.7}{\ignorespaces \textbf {SVD Initialization improves the sample-efficiency}. Convergence when initializing low-rank weights randomly (without SVD) or with SVD.}}{64}{figure.caption.62}%
\contentsline {figure}{\numberline {3.8}{\ignorespaces \textbf {The joint loss converges generally better}. Convergence of the three losses illustrated in Figure~\ref {fig:distillaton}, evaluated on the Wikitext2 test corpus perplexity during distillation.}}{64}{figure.caption.63}%
